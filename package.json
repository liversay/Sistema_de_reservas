{
  "name": "sistema-reservas",
  "private": true,
  "workspaces": ["src/*"],
  "scripts": {
    "db:start": "bun scripts/db-start.ts",
    "db:stop": "bun scripts/db-stop.ts",
    "db:seed": "bun src/api/seed.ts",
    "dev": "bun scripts/dev.ts",
    "dev:api": "bun --watch src/api/server.ts",
    "dev:web": "cd src/web && bun run dev",
    "build:web": "cd src/web && bun run build",
    "test:unit": "bun test tests/unit",
    "test": "bun test"
  },
  "devDependencies": {
    "@canchas/shared": "workspace:*",
    "@types/bun": "latest",
    "mongodb": "^6.10.0",
    "typescript": "^5.6.0"
  }
}
